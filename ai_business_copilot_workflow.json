      ],
      "webhookId": "ai-business-copilot-webhook"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst text = String(body.message ?? body.query ?? '').trim();\nreturn [{json: {message: text, customerName: String(body.customerName ?? 'Guest').trim(), email: String(body.email ?? '').trim(), channel: String(body.channel ?? 'Website').trim(), receivedAt: new Date().toISOString()}}];"
      },
      "id": "node-02-normalize",
      "name": "2. Normalize Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "valid-message",
              "leftValue": "={{ $json.message }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-03-validate",
      "name": "3. Validate Input",
