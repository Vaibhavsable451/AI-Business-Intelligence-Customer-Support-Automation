          "responseCode": 400
        }
      },
      "id": "node-04-invalid",
      "name": "4. Return Validation Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        660,
        520
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.GROQ_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { model: 'llama-3.3-70b-versatile', temperature: 0.2, max_tokens: 700, response_format: { type: 'json_object' }, messages: [ { role: 'system', content: 'You are an enterprise customer-support triage assistant. Analyze the request and return ONLY valid JSON with keys: category, sentiment, priority, summary, recommended_action, reply. category must be one of Billing, Technical, Account, Product, Other. sentiment must be Positive, Neutral, or Negative. priority must be High, Medium, or Low. Keep summary and recommended_action concise. Write a helpful professional customer reply.' }, { role: 'user', content: 'Customer: ' + $('2. Normalize Request').item.json.customerName + '\\nChannel: ' + $('2. Normalize Request').item.json.channel + '\\nRequest: ' + $('2. Normalize Request').item.json.message } ] } }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "node-05-groq",
      "name": "5. Groq AI Analysis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "const source = $('2. Normalize Request').item.json;\nconst raw = $json.choices?.[0]?.message?.content ?? '{}';\nlet ai;\ntry { ai = JSON.parse(raw); } catch (e) { ai = {category:'Other', sentiment:'Neutral', priority:'Medium', summary:source.message.slice(0,180), recommended_action:'Review the request manually.', reply:'Thank you for contacting us. Our team will review your request and get back to you.'}; }\nconst allowed = ['High','Medium','Low'];\nconst priority = allowed.includes(ai.priority) ? ai.priority : 'Medium';\nreturn [{json:{...source, category:ai.category ?? 'Other', sentiment:ai.sentiment ?? 'Neutral', priority, summary:ai.summary ?? '', recommendedAction:ai.recommended_action ?? '', reply:ai.reply ?? '', aiRaw:raw}}];"
      },
      "id": "node-06-parse",
      "name": "6. Parse AI Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        220
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.priority }}",
                    "rightValue": "High",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "High"
            },
